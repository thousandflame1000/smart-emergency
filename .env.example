# =============================================
# 鄰里守望平台 - 環境變數設定
# 複製此檔案為 .env 並填入真實數值
# =============================================

# Database
# 本機開發用 SQLite 即可：sqlite:///./linri.db
# 正式環境用 Railway 提供的 PostgreSQL 連線字串（Railway 專案的 Postgres 服務會自動產生 DATABASE_URL）
DATABASE_URL=sqlite:///./linri.db

# LINE Bot
# 從 LINE Developers Console 取得
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# Gemini
GEMINI_API_KEY=your_gemini_api_key
# 預設關閉，避免未經營運單位確認就把問題/知識庫段落送到外部 AI。
EXTERNAL_AI_ENABLED=false

# App
APP_ENV=development
TASK_WORKFLOW_V2=false
TASK_COMMAND_SECRET=
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BASE_DELAY_SECONDS=15
OUTBOX_MAX_DELAY_SECONDS=3600
OUTBOX_LEASE_SECONDS=120
OUTBOX_RETENTION_DAYS=90
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BASE_DELAY_SECONDS=10
WEBHOOK_MAX_DELAY_SECONDS=900
WEBHOOK_LEASE_SECONDS=120
WEBHOOK_RETENTION_DAYS=30

# 個資告知事項。正式上線前務必改成真實法人/機構名稱與可聯絡窗口。
PRIVACY_NOTICE_VERSION=2026-09-27
PRIVACY_CONTROLLER_NAME=請填入營運機構全名
PRIVACY_CONTACT=請填入電話、電子郵件或正式聯絡方式

# 不需要跨網域前端時保持空白；多個來源以逗號分隔，勿使用 *。
CORS_ALLOWED_ORIGINS=

# 商用或高流量部署應指向自管/有 SLA 的 geocoder；公用 Nominatim 僅適合低流量。
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=SmartEmergency/1.0 (mailto:operator@example.org)

# 決賽展演期間的臨時共用密碼（HTTP Basic Auth，保護 / 跟 /admin 不被
# 陌生人用連結亂入看到長者個資或亂動展演狀態）。留空 = 不啟用。
DEMO_PASSWORD=
