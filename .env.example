# =============================================
# 鄰里守望平台 - 環境變數設定
# 複製此檔案為 .env 並填入真實數值
# =============================================

# Database
# 本機開發用 SQLite 即可：sqlite:///./linri.db
# 正式環境用 Railway 提供的 PostgreSQL 連線字串（Railway 專案的 Postgres 服務會自動產生 DATABASE_URL）
DATABASE_URL=sqlite:///./linri.db

# LINE Bot
# 從 LINE Developers Console 取得
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# Gemini
GEMINI_API_KEY=your_gemini_api_key

# App
APP_ENV=development
TASK_WORKFLOW_V2=false
TASK_COMMAND_SECRET=
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BASE_DELAY_SECONDS=15
OUTBOX_MAX_DELAY_SECONDS=3600
OUTBOX_LEASE_SECONDS=120

# 決賽展演期間的臨時共用密碼（HTTP Basic Auth，保護 / 跟 /admin 不被
# 陌生人用連結亂入看到長者個資或亂動展演狀態）。留空 = 不啟用。
DEMO_PASSWORD=
